DATABASE_URL="postgresql://raisins:raisins@localhost:5432/assocompta?schema=public"

# Authentification (voir src/lib/auth.ts). Sans SESSION_SECRET, l'application
# reste accessible sans connexion. Une fois définie, le tout premier compte se
# crée sur /connexion/premier-compte, protégé par BOOTSTRAP_ADMIN_PASSWORD
# (clé de démarrage à usage unique, distincte du mot de passe du compte).
# SESSION_SECRET : chaîne aléatoire longue (ex. `openssl rand -base64 32`).
SESSION_SECRET="change-moi-avec-une-longue-chaine-aleatoire"
BOOTSTRAP_ADMIN_PASSWORD="change-moi"

# Mot de passe oublié (voir src/lib/reinitialisation-mdp.ts) : compte SMTP de la PLATEFORME
# (LBSOFT), jamais celui d'une association. Port 465 = TLS implicite, sinon STARTTLS.
# PLATEFORME_SMTP_FROM : adresse expéditrice (défaut : PLATEFORME_SMTP_USER). Sans ces variables,
# la demande de réinitialisation est acceptée mais aucun email n'est envoyé.
PLATEFORME_SMTP_HOST="ssl0.ovh.net"
PLATEFORME_SMTP_PORT="465"
PLATEFORME_SMTP_USER="noreply@exemple.fr"
PLATEFORME_SMTP_PASSWORD="change-moi"
PLATEFORME_SMTP_FROM="noreply@exemple.fr"

# Base des liens envoyés par email (mot de passe oublié) — jamais déduite de l'en-tête Host de la
# requête (falsifiable). Sans elle : l'URL Vercel de production, sinon http://localhost:3010 en dev.
SITE_URL="http://localhost:3010"
