generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleUtilisateur {
  // Éditeur de la solution (LBSOFT) : crée les comptes association depuis
  // /administration, aucun accès aux données d'une association (pas de
  // associationId) — même principe que admin_global sur raisins-app.
  superviseur
  // Saisie des mouvements, paramétrage (journaux, catégories, exercices),
  // clôture. Rattaché à une association.
  tresorier
  // Consultation uniquement (mouvements, états) — président, commissaire aux
  // comptes... Rattaché à une association.
  lecture_seule
}

enum TypeMouvement {
  recette
  depense
  virement_interne
}

enum TypeTransaction {
  virement
  prelevement
  cheque
  especes
  autre
}

// Une association cliente (le tenant). Chaque association est indépendante :
// pas de structure "cabinet" qui en gère plusieurs (décision du 29/09/2026).
model Association {
  id        Int      @id @default(autoincrement())
  nom       String
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  utilisateurs   Utilisateur[]
  exercices      Exercice[]
  journaux       Journal[]
  categories     Categorie[]
  mouvements     Mouvement[]
  rapprochements Rapprochement[]
}

model Utilisateur {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  motDePasseHash String
  role           RoleUtilisateur
  actif          Boolean         @default(true)
  // Incrémentée pour invalider toute session ouverte (désactivation,
  // changement de mot de passe) — voir src/lib/auth.ts.
  sessionVersion Int             @default(0)
  createdAt      DateTime        @default(now())

  // Toujours null pour un superviseur ; toujours renseigné pour tresorier/lecture_seule.
  associationId Int?
  association   Association? @relation(fields: [associationId], references: [id])

  reinitialisations ReinitialisationMotDePasse[]

  @@index([associationId])
}

// « Mot de passe oublié » (voir src/lib/reinitialisation-mdp.ts) : jeton à usage unique, jamais
// stocké en clair (seul son SHA-256 l'est), valable 1 heure.
model ReinitialisationMotDePasse {
  id            Int         @id @default(autoincrement())
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  jetonHash     String      @unique
  expireLe      DateTime
  createdAt     DateTime    @default(now())

  @@index([utilisateurId])
}

// Un exercice comptable de l'association (dates paramétrables : année civile
// ou année scolaire selon l'association). Plusieurs exercices coexistent
// (précédent/en cours/suivant, avant clôture) : voir cahier des charges.
model Exercice {
  id            Int       @id @default(autoincrement())
  associationId Int
  association   Association @relation(fields: [associationId], references: [id])
  libelle       String
  dateDebut     DateTime
  dateFin       DateTime
  cloture       Boolean   @default(false)
  clotureLe     DateTime?

  mouvements    Mouvement[]
  soldesCloture SoldeCloture[]

  @@unique([associationId, libelle])
  @@index([associationId])
}

// Caisse ou compte bancaire — paramétrable par association, pas figé à un
// nombre fixe de comptes.
model Journal {
  id            Int         @id @default(autoincrement())
  associationId Int
  association   Association @relation(fields: [associationId], references: [id])
  nom           String
  actif         Boolean     @default(true)
  // Solde antérieur à tout mouvement enregistré dans l'application (reprise d'un compte déjà
  // existant) — saisi à la création du premier exercice utile (voir src/lib/tresorerie.ts,
  // exerciceDemandeSoldesOuverture()), jamais recalculé automatiquement ensuite.
  soldeInitial  Float       @default(0)

  mouvements            Mouvement[]     @relation("MouvementJournal")
  mouvementsDestination Mouvement[]     @relation("MouvementJournalDestination")
  rapprochements        Rapprochement[]
  soldesCloture         SoldeCloture[]

  @@unique([associationId, nom])
  @@index([associationId])
}

// Un rapprochement bancaire validé : fige le solde du relevé à une date donnée comme nouveau point
// de départ, et verrouille les mouvements qui y ont été rattachés (voir Mouvement.rapprochementId)
// — ils ne sont plus dépointables individuellement, seule la suppression de CE rapprochement les
// libère tous ensemble (src/lib/rapprochement.ts). Jamais modifié après coup : seulement créé ou
// supprimé en bloc.
model Rapprochement {
  id            Int         @id @default(autoincrement())
  associationId Int
  association   Association @relation(fields: [associationId], references: [id])
  journalId     Int
  journal       Journal     @relation(fields: [journalId], references: [id])
  date          DateTime
  solde         Float
  createdAt     DateTime    @default(now())

  mouvements Mouvement[]

  @@index([associationId])
  @@index([journalId])
}

// Poste de recette ou de dépense, paramétrable par association (chaque
// association a ses propres postes budgétaires).
model Categorie {
  id            Int             @id @default(autoincrement())
  associationId Int
  association   Association     @relation(fields: [associationId], references: [id])
  nom           String
  type          TypeMouvement
  actif         Boolean         @default(true)

  sousCategories SousCategorie[]

  @@unique([associationId, nom, type])
  @@index([associationId])
}

model SousCategorie {
  id          Int       @id @default(autoincrement())
  categorieId Int
  categorie   Categorie @relation(fields: [categorieId], references: [id])
  nom         String
  actif       Boolean   @default(true)

  ventilations MouvementVentilation[]

  @@unique([categorieId, nom])
}

// Un mouvement de trésorerie. Le montant total est la somme de ses lignes de
// ventilation (au moins une) — voir MouvementVentilation.
model Mouvement {
  id            Int             @id @default(autoincrement())
  associationId Int
  association   Association     @relation(fields: [associationId], references: [id])
  exerciceId    Int
  exercice      Exercice        @relation(fields: [exerciceId], references: [id])
  journalId     Int
  journal       Journal         @relation("MouvementJournal", fields: [journalId], references: [id])
  // Date de saisie : la date réelle de l'opération, telle qu'indiquée par le trésorier.
  date          DateTime
  // Date bilan : date prise en compte pour les rapports, dérivée de la date de saisie et de la
  // position de l'exercice du mouvement par rapport à l'exercice en cours au moment de la saisie —
  // voir src/lib/date-bilan.ts. Recalculée si la date de saisie change (jamais après rapprochement).
  dateBilan     DateTime
  type          TypeMouvement
  typeTransaction TypeTransaction
  // Montant total du mouvement (toujours positif) — pour recette/dépense, doit égaler la somme des
  // lignes de ventilation ; un virement_interne n'a pas de catégorie, donc aucune ventilation.
  montant       Float
  tiers         String?
  numeroCheque  String?
  numeroFacture String?
  commentaire   String?
  // Renseigné seulement pour un virement_interne (l'autre compte impacté).
  journalDestinationId Int?
  journalDestination   Journal? @relation("MouvementJournalDestination", fields: [journalDestinationId], references: [id])
  // Rapprochement bancaire (pointage manuel) : pointe = "vu sur le relevé", vrai dès cette étape.
  // rapprochementId n'est renseigné qu'une fois le rapprochement VALIDÉ (voir
  // src/lib/rapprochement.ts) — à partir de là, le mouvement est verrouillé : on ne peut plus le
  // dépointer qu'en supprimant ce rapprochement dans son ensemble.
  pointe          Boolean        @default(false)
  pointeLe        DateTime?
  rapprochementId Int?
  rapprochement   Rapprochement? @relation(fields: [rapprochementId], references: [id])
  createdAt       DateTime       @default(now())

  ventilations MouvementVentilation[]

  @@index([associationId])
  @@index([journalId])
  @@index([exerciceId])
  @@index([rapprochementId])
}

// Répartit un mouvement (recette ou dépense) sur une ou plusieurs sous-catégories : la somme des
// montants de ventilation égale le montant du mouvement.
model MouvementVentilation {
  id              Int           @id @default(autoincrement())
  mouvementId     Int
  mouvement       Mouvement     @relation(fields: [mouvementId], references: [id], onDelete: Cascade)
  sousCategorieId Int
  sousCategorie   SousCategorie @relation(fields: [sousCategorieId], references: [id])
  montant         Float

  @@index([mouvementId])
  @@index([sousCategorieId])
}

// Solde de chaque compte figé à la clôture d'un exercice : il devient l'ouverture de l'exercice suivant
// (voir src/lib/bilan.ts). Supprimé à la réouverture de l'exercice.
model SoldeCloture {
  id         Int      @id @default(autoincrement())
  exerciceId Int
  exercice   Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)
  journalId  Int
  journal    Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  solde      Float

  @@unique([exerciceId, journalId])
  @@index([journalId])
}
